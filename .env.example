# Application
WV_ELEICOES_API_APP_NAME=WV Eleicoes API
WV_ELEICOES_API_ENVIRONMENT=development
WV_ELEICOES_API_LOG_LEVEL=INFO
WV_ELEICOES_API_API_PREFIX=/api/v1

# Read-only PostgreSQL role. Keep real credentials outside Git.
# Example only; replace host/password locally or in the server EnvironmentFile.
WV_ELEICOES_API_DATABASE_URL=postgresql+psycopg://wv_eleicoes_api:CHANGE_ME@127.0.0.1:5432/wv_eleicoes
WV_ELEICOES_API_DATABASE_POOL_SIZE=5
WV_ELEICOES_API_DATABASE_MAX_OVERFLOW=5
WV_ELEICOES_API_DATABASE_POOL_TIMEOUT_SECONDS=5
WV_ELEICOES_API_DATABASE_STATEMENT_TIMEOUT_MS=5000
